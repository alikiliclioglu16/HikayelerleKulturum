{
  "id": "bayram-sabahi",
  "title": "Bayram Sabahı",
  "titleEn": "Bayram Morning",
  "culture": {
    "tr": "Ramazan Bayramı",
    "en": "Ramadan Bayram (Eid al-Fitr)"
  },
  "summary": {
    "tr": "Elif ile kardeşi Can, Amerika'daki evlerinde ilk bayram sabahını karşılıyor: bayramlıklar, baklava, babaanneyle görüntülü arama, el öpme, adil paylaşım ve bayramı ilk kez duyan bir arkadaş.",
    "en": "Elif and her little brother Can celebrate Bayram at their home in America: new clothes, baklava, a video call with Grandma, kissing an elder's hand, sharing fairly and a friend who hears about Bayram for the first time."
  },
  "values": [
    "saygi",
    "aile-butunlugu",
    "adalet",
    "dostluk"
  ],
  "kazanim": "Bayram geleneklerini tanır; büyüklerine saygıyla el öper, sevincini ailesi ve arkadaşlarıyla adil biçimde paylaşır.",
